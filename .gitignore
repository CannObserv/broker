__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
.ruff_cache/
.coverage
*.egg-info/

# Claude Code's machine-local settings. Holds the cohort's single shared Qdrant
# API key once broker#17 lands, and this repo is public: a commit is one push
# from a rotation on every cohort VM. Pinned by tests/deploy/test_socraticode_config.py.
.claude/settings.local.json

# The retired GCS wheelhouse mirror (#144: co-core comes from the co-pypi index
# now). A checkout from before it keeps the synced files until removed by hand;
# ignored, they are no change for scripts/deploy.sh's clean-tree check.
/.wheelhouse/

# A release's build id, written by scripts/deploy.sh at the release root (#106).
# A copy in a checkout would make it claim to be a release instead of `dev`
# (src/broker/revision.py). `git archive` never ships an untracked file, so a
# release loses nothing. Pinned by tests/test_revision.py.
/REVISION

# Throwaway-server scratch (tempfile.mkdtemp under the checkout). #114's ACL
# rehearsal committed fourteen rendered copies this way, plaintext test
# passwords and all; tests/deploy/test_redis_acl.py now refuses any tracked ACL
# line outside deploy/redis-acl.conf.
/tmp*/

# using-git-worktrees' default root (no .skills/worktree_root here). Its
# worktree-create.sh refuses a root git does not ignore (gregoryfoster/skills#567),
# and .git/info/exclude reaches no other clone (#138). Pinned by
# tests/deploy/test_socraticode_config.py.
/.worktrees/
