#!/usr/bin/env bash
# The commit-time half of the lint gate (#112): shellcheck and ruff over what is
# staged. Enabled per clone, `git config core.hooksPath .githooks` (docs/CI.md).
# --no-verify skips it, so CI's lint + test job is the enforcement.
#
# It lints the working-tree copy of each staged path, so a partly staged file is
# read as it stands on disk. The tools come from uv.lock's lint group, without
# the project, so a clone needs no wheelhouse to commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

scripts/shellcheck.sh --staged

# ruff lints Python and formats Python and the docs' fences (#38). --force-exclude:
# a path named on the command line is still held to extend-exclude (skills-vendor/).
python=() formatted=()
while IFS= read -r -d '' f; do
	formatted+=("$f")
	[[ $f == *.md ]] || python+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' '*.pyi' '*.md')

if [ ${#python[@]} -gt 0 ]; then
	uv run --frozen --only-group lint ruff check --force-exclude -- "${python[@]}"
fi
if [ ${#formatted[@]} -gt 0 ]; then
	uv run --frozen --only-group lint ruff format --check --force-exclude -- "${formatted[@]}"
fi
