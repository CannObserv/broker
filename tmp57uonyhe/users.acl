user archiver on >rehearsal-pw resetchannels +info +ping (+xreadgroup +xack +xautoclaim +xgroup|create ~content.revisions ~content.artifacts ~info.watch-events) (+xpending ~content.revisions ~content.artifacts) (+xread ~info.watch-status) (+xlen +xrange ~content.revisions.dlq ~content.artifacts.dlq ~info.watch-events.dlq) (+xadd ~content.replicate ~content.persist ~info.changes ~info.registry ~content.revisions.dlq ~content.artifacts.dlq ~content.fetch-policy ~info.watch-check ~info.watch-events.dlq ~content.capture) (+xtrim ~info.changes) (+xdel ~content.revisions.dlq ~content.artifacts.dlq ~info.watch-events.dlq)
user watcher on >rehearsal-pw resetchannels +info +ping (+xreadgroup +xack +xautoclaim +xgroup|create ~content.blobs ~content.derived ~info.watch-check) (+xread ~info.registry) (+xinfo|stream +xrange ~info.watch-status) (+xlen ~content.fetch ~content.revisions) (+xlen +xrange ~content.blobs.dlq ~content.derived.dlq ~info.watch-check.dlq) (+xadd ~content.fetch ~content.fetch-policy ~content.revisions ~info.watch-status ~content.blobs.dlq ~content.process ~content.derived.dlq ~info.watch-events ~info.watch-check.dlq) (+xdel ~content.blobs.dlq ~content.derived.dlq ~info.watch-check.dlq)
